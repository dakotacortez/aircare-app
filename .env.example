# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Maps API key for real-time ETA calculations
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Resend API key for sending emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email configuration
# IMPORTANT: Use a subdomain for transactional emails (recommended by Resend for best deliverability)
# Examples: ping.acmc.app, email.acmc.app, or notifications.yourdomain.com
# See: https://resend.com/docs/dashboard/domains/introduction
FROM_EMAIL=noreply@ping.acmc.app
FROM_NAME=Air Care & Mobile Care

# Firebase Cloud Messaging (FCM) for push notifications (Android/iOS)
# Get credentials from: https://console.firebase.google.com
# Optional - only needed if you want push notifications
FCM_SERVER_KEY=your_fcm_server_key_here
FCM_PROJECT_ID=your_firebase_project_id
