# Database connection string
DATABASE_URI=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URI=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Google Maps API key for real-time ETA calculations
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# HERE API key for real-time ETA calculations (alternative to Google Maps)
# Get your API key from: https://developer.here.com/
HERE_API_KEY=your-here-api-key-here

# ETA Provider Configuration
# Primary provider: 'google' or 'here'
# Choose based on pricing and availability
ETA_PROVIDER=google

# Enable automatic fallback to alternate provider if primary fails
# If enabled and primary provider fails, will try the other provider
# Set to 'false' to disable fallback
ETA_FALLBACK_ENABLED=true

# Resend API key for sending emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Email configuration
# IMPORTANT: Use a subdomain for transactional emails (recommended by Resend for best deliverability)
# Examples: ping.acmc.app, email.acmc.app, or notifications.yourdomain.com
# See: https://resend.com/docs/dashboard/domains/introduction
FROM_EMAIL=noreply@ping.acmc.app
FROM_NAME=Air Care & Mobile Care

# Firebase Cloud Messaging (FCM) for push notifications (Android/iOS)
# Uses Firebase Admin SDK with HTTP v1 API (legacy API deprecated 6/20/2024)
# Get service account credentials from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/serviceaccounts/adminsdk
# Optional - only needed if you want push notifications

# Method 1 (Recommended): Use service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/firebase-admin.json
FCM_PROJECT_ID=aircare-app

# Method 2 (Alternative): Use individual credentials from the JSON file
# FCM_PROJECT_ID=your_firebase_project_id
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
# FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
